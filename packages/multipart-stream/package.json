{
  "name": "@browsery/multipart-stream",
  "version": "2.0.1-r1",
  "description": "Browser compatible multipart-stream module",
  "author": "Panates",
  "license": "MIT",
  "scripts": {
    "prebuild": "npm run clean && npm run lint",
    "build": "node build.mjs",
    "clean": "rimraf build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn"
  },
  "devDependencies": {
    "multipart-stream": "^2.0.1"
  },
  "type": "commonjs",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/browsery.git",
    "directory": "packages/http-parser"
  },
  "keywords": [
    "multipart",
    "stream",
    "request",
    "http",
    "streaming",
    "browser",
    "browsery",
    "browserify"
  ],
  "buildDir": "./build",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
